# ---------------------------------------------------------------------------
# DEMO VALUES ONLY — NOT SECRETS. Committed on purpose: the assignment requires
# the prototype to start with no secrets or outside accounts. These keys protect
# nothing real. In production they come from a secrets manager / KMS
# (see README "Prototype Shortcuts"). Never put real credentials in this file.
#
# Hostnames below are Docker Compose service names. For local development outside
# Docker, override them in your shell or in an untracked .env.local.
# ---------------------------------------------------------------------------

# Data stores
DATABASE_URL=postgresql://clever:clever-demo@postgres:5432/investor_platform?schema=public

# Sessions (HS256 JWT, 8 h) and seller PII encryption (AES-256-GCM, key version v1)
JWT_SECRET=2ec39004e561aa79569d374693f261dd65d9e7082d9acfeb44da521dda115d0d
PII_ENCRYPTION_KEY=v1:bRew7/2S8bHRbjY+O+GxwxQ6F9MtLlmRXNKXlkRrsgo=
ADDRESS_HASH_KEY=c0418d6bd39f80a69ac6f397ac4196cbac1ce4178c8e149a375b526aebaab52b

# Service URLs (internal = container network; public = what the reviewer's browser uses)
API_URL=http://api:4000
SANDBOX_URL=http://sandbox:4100
PUBLIC_SANDBOX_URL=http://localhost:4100
# The web app's addresses (comma-separated, one per brand host) the sandbox accepts uploads from
WEB_ORIGIN=http://localhost:3000,http://partner.localhost:3000

# Sandbox stand-in (shared token for internal calls; HMAC key for signed upload URLs)
SANDBOX_INTERNAL_TOKEN=a67dcbbf447717f54f7391e0a1f979906236af713ebfead9
STORAGE_SIGNING_KEY=df0362b6ff86394d82e79012199bb61c5e98aef0555a4ecba4217a6128cd5a0b
SANDBOX_STORAGE_DIR=/data/sandbox-objects

# Provider selection (Constitution XIV). Only "sandbox" is implemented in the prototype.
CRM_PROVIDER=sandbox
MESSAGING_PROVIDER=sandbox
STORAGE_PROVIDER=sandbox
ERROR_REPORTER=log

# Web
# auto: cookies are Secure when the browser came over HTTPS (directly or through a proxy that
# sets X-Forwarded-Proto), so sign-in also works over plain HTTP on another host. true/false force it.
COOKIE_SECURE=auto
DEFAULT_BRAND_ID=clever

LOG_LEVEL=info

KANBAN_BOARD=https://github.com/users/ttyagi3963/projects/1
