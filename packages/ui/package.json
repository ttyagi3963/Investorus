{
  "name": "@clever/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system: semantic tokens, React Aria primitives, patterns, and page templates. Holds no brand values (FR-091, R21).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clever/contracts": "workspace:*",
    "react-aria-components": "^1.22.1"
  },
  "devDependencies": {
    "@clever/config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
