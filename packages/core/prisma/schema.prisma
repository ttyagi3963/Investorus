// The database schema: the real definition of every table (data-model.md, locked entities).
// Tables are added as each sprint needs them (Sprint 1: T236, T238, T240, T242, T243; T031 the rest).
// Rules Prisma cannot express, such as CHECKs, are hand-written in the migration SQL.

datasource db {
  provider = "postgresql"
}

// The typed client the repositories use (T244), generated into src/generated/prisma (gitignored)
// by `pnpm generate`, which build, typecheck, and the tests run first.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// Login roles. Each role links to exactly its own record (see User_role_link_check).
enum Role {
  AGENT
  INVESTOR
  OPS
}

// A login account, signed in to by email (stored lowercase). CHECK User_role_link_check
// (migration): an AGENT has agentId only, an INVESTOR has investorId only, OPS has neither.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  displayName  String
  agentId      String?   @unique
  agent        Agent?    @relation(fields: [agentId], references: [id])
  investorId   String?   @unique
  investor     Investor? @relation(fields: [investorId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// The person behind an AGENT login; owns listing packages. Email is how the seed and ops find them.
model Agent {
  id        String           @id @default(cuid())
  name      String
  email     String           @unique
  brokerage String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?
  packages  ListingPackage[]
}

enum InvestorType {
  DIRECT_BUYER
  WHOLESALER
  IBUYER
}

enum InvestorStatus {
  ACTIVE
  INACTIVE
}

// A buying company Clever sends matched packages to (T278). Only ACTIVE investors whose proof
// of funds has not expired are matched (FR-024); proofOfFundsExpiresAt null means unverified.
model Investor {
  id                    String         @id @default(cuid())
  companyName           String
  contactName           String
  email                 String         @unique
  phone                 String?
  investorType          InvestorType
  status                InvestorStatus @default(ACTIVE)
  proofOfFundsExpiresAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User?
  buyBoxes              BuyBox[]
}

// The homeowner's contact details for one listing package. fullName, email, and phone hold
// AES-256-GCM ciphertext (key version prefix), encrypted and decrypted only in the repository
// mapper. No agent here: the package links seller and agent. CHECK Seller_contact_check
// (migration): email or phone is present.
model Seller {
  id        String          @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  package   ListingPackage?
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOME
  MULTI_FAMILY
  MANUFACTURED
  LAND
}

enum PropertyCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DISTRESSED
}

// The home as listed for one package (a relist gets a new row). streetLine holds ciphertext;
// addressHash (HMAC of the normalized address) finds duplicates without decrypting. city and
// state come from the ZIP. Facts are nullable so a draft can be incomplete; range CHECKs and
// "units only for multi-family" are in the migration. lat/lng and the zip and addressHash
// indexes arrive with matching, the first queries that need them.
model Property {
  id             String             @id @default(cuid())
  streetLine     String
  addressHash    String
  zip            String
  city           String
  state          String
  neighborhood   String?
  propertyType   PropertyType
  beds           Int?
  baths          Decimal?           @db.Decimal(3, 1)
  sqft           Int?
  lotSqft        Int?
  units          Int?
  yearBuilt      Int?
  condition      PropertyCondition?
  repairEstimate Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  package        ListingPackage?
}

// Sprint 1 packages are drafts only; the other statuses arrive with publishing.
enum PackageStatus {
  DRAFT
}

// A listing package: one agent, one seller, one property (both unique). addressHash copies the
// property's, so one address can have only one package (FR-013; it becomes a partial unique on
// active statuses when packages can close). CHECK ListingPackage_price_check: 0 < min <= max.
model ListingPackage {
  id                  String        @id @default(cuid())
  agentId             String
  agent               Agent         @relation(fields: [agentId], references: [id])
  sellerId            String        @unique
  seller              Seller        @relation(fields: [sellerId], references: [id])
  propertyId          String        @unique
  property            Property      @relation(fields: [propertyId], references: [id])
  addressHash         String        @unique
  status              PackageStatus @default(DRAFT)
  priceExpectationMin Int
  priceExpectationMax Int
  // Optimistic concurrency: an edit names the version it read, and a stale one is refused.
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  photos              Photo[]

  @@index([agentId, status])
}

// One uploaded photo of a package; the image itself is in the storage provider under
// storageKey. Deleted with its package. CHECKs: JPEG/PNG/WebP, 1 byte to 10 MB, position 0-19.
model Photo {
  id          String         @id @default(cuid())
  packageId   String
  package     ListingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String
  sizeBytes   Int
  position    Int
  createdAt   DateTime       @default(now())

  @@unique([packageId, position])
}

// Clever's offer programs: a package names the ones the seller is open to, and a buy box the ones
// the investor buys through (the `programs` criterion needs one in common).
enum OfferProgram {
  CASH_OFFER
  CASH_WITH_UPSIDE
  SEVEN_DAY_SOLD
}

enum BuyBoxStatus {
  ACTIVE
  PAUSED
}

// A label for organizing and reports; not a criterion.
enum BuyBoxStrategy {
  FIX_FLIP
  BUY_HOLD
  WHOLESALE
  NOVATION
  SELLER_FINANCE
}

enum GeographyMode {
  NATIONWIDE
  STATES
  ZIPS
}

enum GeographyKind {
  STATE
  ZIP
}

// What one investor wants to buy (T279; constitution XIX.2): every criterion is a typed,
// nullable column, and null means "any" (FR-025). An investor can have several boxes; only
// ACTIVE ones are matched. The range and non-empty-list rules are CHECKs in the migration, and
// at most one box per investor is the default (a partial unique index). `version` goes up on
// each save, and match decisions record the version they read.
model BuyBox {
  id                 String              @id @default(cuid())
  investorId         String
  investor           Investor            @relation(fields: [investorId], references: [id], onDelete: Cascade)
  name               String
  status             BuyBoxStatus        @default(ACTIVE)
  isDefault          Boolean             @default(false)
  strategy           BuyBoxStrategy?
  geographyMode      GeographyMode
  propertyTypes      PropertyType[]
  priceMin           Int?
  priceMax           Int?
  yearBuiltMin       Int?
  yearBuiltMax       Int?
  bedsMin            Int?
  bedsMax            Int?
  bathsMin           Decimal?            @db.Decimal(3, 1)
  bathsMax           Decimal?            @db.Decimal(3, 1)
  sqftMin            Int?
  sqftMax            Int?
  unitsMin           Int?
  unitsMax           Int?
  conditionsAccepted PropertyCondition[]
  repairMax          Int?
  closeWithinDays    Int?
  acceptsListed      Boolean             @default(true)
  programsAccepted   OfferProgram[]
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  geography          BuyBoxGeography[]

  @@unique([investorId, name])
  @@index([investorId])
  @@index([status])
}

// The states or ZIPs a STATES or ZIPS buy box covers; a NATIONWIDE box has none. Indexed by
// (kind, value) for matching's first stage.
model BuyBoxGeography {
  id       String        @id @default(cuid())
  buyBoxId String
  buyBox   BuyBox        @relation(fields: [buyBoxId], references: [id], onDelete: Cascade)
  kind     GeographyKind
  value    String

  @@unique([buyBoxId, kind, value])
  @@index([kind, value])
}
