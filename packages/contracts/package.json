{
  "name": "@clever/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, domain types, and the typed REST client (Constitution V). Imports nothing from apps.",
  "exports": {
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./user": {
      "types": "./dist/user/index.d.ts",
      "import": "./dist/user/index.js"
    },
    "./buy-box": {
      "types": "./dist/buy-box/index.d.ts",
      "import": "./dist/buy-box/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "import": "./dist/jobs/index.js"
    },
    "./match": {
      "types": "./dist/match/index.d.ts",
      "import": "./dist/match/index.js"
    },
    "./notification": {
      "types": "./dist/notification/index.d.ts",
      "import": "./dist/notification/index.js"
    },
    "./offer": {
      "types": "./dist/offer/index.d.ts",
      "import": "./dist/offer/index.js"
    },
    "./investor": {
      "types": "./dist/investor/index.d.ts",
      "import": "./dist/investor/index.js"
    },
    "./seller": {
      "types": "./dist/seller/index.d.ts",
      "import": "./dist/seller/index.js"
    },
    "./property": {
      "types": "./dist/property/index.d.ts",
      "import": "./dist/property/index.js"
    },
    "./listing-package": {
      "types": "./dist/listing-package/index.d.ts",
      "import": "./dist/listing-package/index.js"
    },
    "./photo": {
      "types": "./dist/photo/index.d.ts",
      "import": "./dist/photo/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clever/config": "workspace:*"
  }
}
