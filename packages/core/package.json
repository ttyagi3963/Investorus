{
  "name": "@clever/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only domain core: services, workflows, ports, and adapters (Constitution I, XXI.3; research R22).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "scripts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "db:check": "node scripts/prisma-check.mjs",
    "generate": "prisma generate",
    "db:seed": "node dist/infra/seed/run.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@clever/contracts": "workspace:*",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.2",
    "csv-parse": "^7.0.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "~7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clever/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.1"
  }
}
