// The database schema: the real definition of every table (data-model.md, locked entities).
// Tables are added as each sprint needs them (Sprint 1: T236, T238, T240, T242, T243; T031 the rest).
// Rules Prisma cannot express, such as CHECKs, are hand-written in the migration SQL.

datasource db {
  provider = "postgresql"
}

// The typed client the repositories use (T244), generated into src/generated/prisma (gitignored)
// by `pnpm generate`, which build, typecheck, and the tests run first.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// Login roles. Each role links to exactly its own record (see User_role_link_check).
enum Role {
  AGENT
  INVESTOR
  OPS
}

// A login account, signed in to by email (stored lowercase). CHECK User_role_link_check
// (migration): an AGENT has agentId only, an INVESTOR has investorId only, OPS has neither.
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  role            Role
  displayName     String
  agentId         String?          @unique
  agent           Agent?           @relation(fields: [agentId], references: [id])
  investorId      String?          @unique
  investor        Investor?        @relation(fields: [investorId], references: [id])
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notifications   Notification[]
  idempotencyKeys IdempotencyKey[]
}

// The person behind an AGENT login; owns listing packages. Email is how the seed and ops find them.
model Agent {
  id        String           @id @default(cuid())
  name      String
  email     String           @unique
  brokerage String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?
  packages  ListingPackage[]
}

enum InvestorType {
  DIRECT_BUYER
  WHOLESALER
  IBUYER
}

enum InvestorStatus {
  ACTIVE
  INACTIVE
}

// A buying company Clever sends matched packages to (T278). Only ACTIVE investors whose proof
// of funds has not expired are matched (FR-024); proofOfFundsExpiresAt null means unverified.
// externalRef is the legacy spreadsheet's Investor ID, the import's upsert key (T319, FR-061).
model Investor {
  id                    String         @id @default(cuid())
  externalRef           String?        @unique
  companyName           String
  contactName           String
  email                 String         @unique
  phone                 String?
  investorType          InvestorType
  status                InvestorStatus @default(ACTIVE)
  proofOfFundsExpiresAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User?
  buyBoxes              BuyBox[]
  matches               Match[]
  offers                Offer[]
}

// The homeowner's contact details for one listing package. fullName, email, and phone hold
// AES-256-GCM ciphertext (key version prefix), encrypted and decrypted only in the repository
// mapper. No agent here: the package links seller and agent. CHECK Seller_contact_check
// (migration): email or phone is present.
model Seller {
  id        String          @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  package   ListingPackage?
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOME
  MULTI_FAMILY
  MANUFACTURED
  LAND
}

enum PropertyCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DISTRESSED
}

// The home as listed for one package (a relist gets a new row). streetLine holds ciphertext;
// addressHash (HMAC of the normalized address) finds duplicates without decrypting. city and
// state come from the ZIP. Facts are nullable so a draft can be incomplete; range CHECKs and
// "units only for multi-family" are in the migration. lat/lng and the zip and addressHash
// indexes arrive with matching, the first queries that need them.
model Property {
  id             String             @id @default(cuid())
  streetLine     String
  addressHash    String
  zip            String
  city           String
  state          String
  neighborhood   String?
  propertyType   PropertyType
  beds           Int?
  baths          Decimal?           @db.Decimal(3, 1)
  sqft           Int?
  lotSqft        Int?
  units          Int?
  yearBuilt      Int?
  condition      PropertyCondition?
  repairEstimate Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  package        ListingPackage?
}

// The package lifecycle (data-model.md, PackageStatus). From OFFER_ACCEPTED on, the status mirrors
// the active deal's; CLOSED and WITHDRAWN are final and free the address.
enum PackageStatus {
  DRAFT
  ACCEPTING_OFFERS
  NO_OFFERS_RECEIVED
  OFFER_ACCEPTED
  UNDER_CONTRACT
  INSPECTION
  CLOSING
  CLOSED
  FELL_THROUGH
  WITHDRAWN
}

// A listing package: one agent, one seller, one property (both unique). addressHash copies the
// property's, so one address has only one active package (FR-013): a partial unique index in the
// migration, which a closed or withdrawn package does not count against. CHECKs: 0 < min price <= max, and
// the closing window starts no later than it ends. listingVersion is 0 while a draft, 1 at
// publish, and +1 on each material edit; each value has a ListingVersion snapshot.
model ListingPackage {
  id                  String           @id @default(cuid())
  agentId             String
  agent               Agent            @relation(fields: [agentId], references: [id])
  sellerId            String           @unique
  seller              Seller           @relation(fields: [sellerId], references: [id])
  propertyId          String           @unique
  property            Property         @relation(fields: [propertyId], references: [id])
  addressHash         String
  status              PackageStatus    @default(DRAFT)
  round               Int              @default(1)
  priceExpectationMin Int
  priceExpectationMax Int
  closingWindowStart  DateTime?        @db.Date
  closingWindowEnd    DateTime?        @db.Date
  currentlyListed     Boolean?
  eligiblePrograms    OfferProgram[]
  offerDeadline       DateTime?
  publishedAt         DateTime?
  listingVersion      Int              @default(0)
  // Optimistic concurrency: an edit names the version it read, and a stale one is refused.
  version             Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  photos              Photo[]
  versions            ListingVersion[]
  matches             Match[]
  offers              Offer[]
  notifications       Notification[]
  decisions           Decision[]
  deals               Deal[]

  @@index([agentId, status])
  @@index([addressHash])
}

// What a package said at each listing version (append-only; a trigger refuses UPDATE and DELETE):
// the listing facts every criterion reads, with no seller PII. Matching runs against a version,
// so an investor's match always names what they were shown.
model ListingVersion {
  id               String         @id @default(cuid())
  packageId        String
  package          ListingPackage @relation(fields: [packageId], references: [id])
  listingVersion   Int
  round            Int
  snapshot         Json
  evaluatorVersion Int
  createdAt        DateTime       @default(now())

  @@unique([packageId, listingVersion])
}

// One uploaded photo of a package; the image itself is in the storage provider under
// storageKey. Deleted with its package. CHECKs: JPEG/PNG/WebP, 1 byte to 10 MB, position 0-19.
model Photo {
  id          String         @id @default(cuid())
  packageId   String
  package     ListingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String
  sizeBytes   Int
  position    Int
  createdAt   DateTime       @default(now())

  @@unique([packageId, position])
}

// Clever's offer programs: a package names the ones the seller is open to, and a buy box the ones
// the investor buys through (the `programs` criterion needs one in common).
enum OfferProgram {
  CASH_OFFER
  CASH_WITH_UPSIDE
  SEVEN_DAY_SOLD
}

enum BuyBoxStatus {
  ACTIVE
  PAUSED
}

// A label for organizing and reports; not a criterion.
enum BuyBoxStrategy {
  FIX_FLIP
  BUY_HOLD
  WHOLESALE
  NOVATION
  SELLER_FINANCE
}

enum GeographyMode {
  NATIONWIDE
  STATES
  ZIPS
}

enum GeographyKind {
  STATE
  ZIP
}

// What one investor wants to buy (T279; constitution XIX.2): every criterion is a typed,
// nullable column, and null means "any" (FR-025). An investor can have several boxes; only
// ACTIVE ones are matched. The range and non-empty-list rules are CHECKs in the migration, and
// at most one box per investor is the default (a partial unique index). `version` goes up on
// each save, and match decisions record the version they read.
model BuyBox {
  id                 String              @id @default(cuid())
  investorId         String
  investor           Investor            @relation(fields: [investorId], references: [id], onDelete: Cascade)
  name               String
  status             BuyBoxStatus        @default(ACTIVE)
  isDefault          Boolean             @default(false)
  strategy           BuyBoxStrategy?
  geographyMode      GeographyMode
  propertyTypes      PropertyType[]
  priceMin           Int?
  priceMax           Int?
  yearBuiltMin       Int?
  yearBuiltMax       Int?
  bedsMin            Int?
  bedsMax            Int?
  bathsMin           Decimal?            @db.Decimal(3, 1)
  bathsMax           Decimal?            @db.Decimal(3, 1)
  sqftMin            Int?
  sqftMax            Int?
  unitsMin           Int?
  unitsMax           Int?
  conditionsAccepted PropertyCondition[]
  repairMax          Int?
  closeWithinDays    Int?
  acceptsListed      Boolean             @default(true)
  programsAccepted   OfferProgram[]
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  geography          BuyBoxGeography[]
  versions           BuyBoxVersion[]

  @@unique([investorId, name])
  @@index([investorId])
  @@index([status])
}

// The states or ZIPs a STATES or ZIPS buy box covers; a NATIONWIDE box has none. Indexed by
// (kind, value) for matching's first stage.
model BuyBoxGeography {
  id       String        @id @default(cuid())
  buyBoxId String
  buyBox   BuyBox        @relation(fields: [buyBoxId], references: [id], onDelete: Cascade)
  kind     GeographyKind
  value    String

  @@unique([buyBoxId, kind, value])
  @@index([kind, value])
}

// One saved version of a buy box (T319): every criterion and the geography as the save left them,
// so a match decision can be explained later by the version it read. Append-only (a trigger
// refuses UPDATE and DELETE); createdBy is the user who saved it, null for the seed or the import.
model BuyBoxVersion {
  id        String   @id @default(cuid())
  buyBoxId  String
  buyBox    BuyBox   @relation(fields: [buyBoxId], references: [id], onDelete: Restrict)
  version   Int
  snapshot  Json
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([buyBoxId, version])
}

// What first shared a package with an investor in a round.
enum MatchTrigger {
  PUBLISH
  PACKAGE_EDIT
  REOPEN
  BUY_BOX_CHANGE
}

// An investor's access to a package in one offer round (T281; FR-022, FR-040): created when at
// least one of their buy boxes matches, and never deleted by a later edit, so a shared package
// stays visible. One row per investor per package per round, so a re-run cannot notify twice.
model Match {
  id                         String         @id @default(cuid())
  packageId                  String
  package                    ListingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  investorId                 String
  investor                   Investor       @relation(fields: [investorId], references: [id], onDelete: Cascade)
  round                      Int
  matchedBuyBoxIds           String[]
  trigger                    MatchTrigger
  firstMatchedAt             DateTime       @default(now())
  // The listing version the investor was last told about, so an edit notifies them once.
  lastNotifiedListingVersion Int?
  // When a buy-box-change match went out in the daily digest email (T336; FR-023).
  digestedAt                 DateTime?

  @@unique([packageId, investorId, round])
  @@index([investorId])
}

enum JobType {
  MATCH_PACKAGE
  MATCH_BUY_BOX
  IMPORT_INVESTORS
  CLOSE_OFFER_ROUND
  EXPIRE_OFFER
  EXPIRE_RECONFIRMATION
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// A durable unit of background work (T281; constitution VIII): the worker claims QUEUED jobs
// whose runAt has come, with FOR UPDATE SKIP LOCKED, so a crash or restart loses nothing. A
// partial unique index (migration) allows one live job per (type, dedupeKey). correlationId is
// the request that enqueued it, logged with every line of its run. error is redacted.
model Job {
  id            String       @id @default(cuid())
  type          JobType
  status        JobStatus    @default(QUEUED)
  dedupeKey     String
  payload       Json
  runAt         DateTime     @default(now())
  retryCount    Int          @default(0)
  maxRetries    Int          @default(3)
  error         String?
  lockedAt      DateTime?
  lockedBy      String?
  correlationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  importBatch   ImportBatch?

  @@index([status, runAt])
}

enum NotificationType {
  PACKAGE_MATCHED
  PACKAGE_CHANGED
  PACKAGE_WITHDRAWN
  OFFER_ROUND_CLOSED
  OFFER_DEADLINE_EXTENDED
  OFFER_EXPIRED
  OFFER_COUNTERED
  COUNTER_ANSWERED
  OFFER_ACCEPTED
  OFFER_BACKUP
  OFFER_DECLINED
  PACKAGE_CLOSED_TO_OFFERS
  DEAL_MILESTONE
  DEAL_FELL_THROUGH
  BACKUP_PROMOTED
  BACKUP_RECONFIRMED
  RECONFIRMATION_DECLINED
}

// One in-app message for one user (T281), written in the same transaction as the change it
// reports. Title and body never carry seller details.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  packageId String?
  package   ListingPackage?  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

// The offer lifecycle (data-model.md, OfferStatus). ACTIVE, COUNTERED, BACKUP, and ACCEPTED are
// "live": an investor has at most one live offer per package and round.
enum OfferStatus {
  ACTIVE
  COUNTERED
  BACKUP
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
  FELL_THROUGH
  DECLINED_TO_RECONFIRM
}

enum PaymentType {
  CASH
  FINANCED
}

enum Contingency {
  INSPECTION
  FINANCING
  APPRAISAL
  TITLE
  SALE_OF_HOME
}

// An investor's offer on a package in one round (T281; FR-042), at its latest revision. A partial
// unique index (migration) allows one live offer per investor per package per round. CHECKs:
// price > 0, earnest money and fees >= 0, and a FINANCED offer lists the FINANCING contingency.
model Offer {
  id                 String          @id @default(cuid())
  packageId          String
  package            ListingPackage  @relation(fields: [packageId], references: [id])
  investorId         String
  investor           Investor        @relation(fields: [investorId], references: [id])
  round              Int
  status             OfferStatus     @default(ACTIVE)
  currentRevision    Int             @default(1)
  price              Int
  paymentType        PaymentType
  closingDate        DateTime        @db.Date
  earnestMoney       Int
  contingencies      Contingency[]
  feesAndConcessions Int
  expiresAt          DateTime
  version            Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  revisions          OfferRevision[]
  deal               Deal?
  decisions          Decision[]

  @@index([packageId, round])
}

// Who wrote an offer revision: the investor, or the agent with a counter (FR-052).
enum RevisionAuthor {
  INVESTOR
  AGENT
}

// Each set of terms an offer has had (append-only; a trigger refuses UPDATE and DELETE), so the
// agent can see how an offer changed. A counter is an AGENT revision.
model OfferRevision {
  id        String         @id @default(cuid())
  offerId   String
  offer     Offer          @relation(fields: [offerId], references: [id])
  revision  Int
  author    RevisionAuthor @default(INVESTOR)
  terms     Json
  createdAt DateTime       @default(now())

  @@unique([offerId, revision])
}

enum DecisionType {
  ACCEPT
  COUNTER
  DECLINE_ALL
}

// The seller's decision as the agent recorded it (T304; FR-052), append-only (a trigger refuses
// UPDATE and DELETE). CHECK (migration): ACCEPT and COUNTER name the offer. Its package and offer
// are never deleted while it exists (RESTRICT), since decisions are history (data-model.md). `note` is free text the
// agent writes, so it holds AES-256-GCM ciphertext like the seller columns (XII).
model Decision {
  id          String         @id @default(cuid())
  packageId   String
  package     ListingPackage @relation(fields: [packageId], references: [id])
  round       Int
  type        DecisionType
  offerId     String?
  offer       Offer?         @relation(fields: [offerId], references: [id], onDelete: Restrict)
  actorUserId String
  note        String?
  createdAt   DateTime       @default(now())

  @@index([packageId])
}

// The deal lifecycle (data-model.md, DealStatus). CLOSED, FELL_THROUGH, and RECONFIRM_DECLINED are
// final; PENDING_RECONFIRMATION is a promoted backup who has not yet reconfirmed.
enum DealStatus {
  PENDING_RECONFIRMATION
  OFFER_ACCEPTED
  UNDER_CONTRACT
  INSPECTION
  CLOSING
  CLOSED
  FELL_THROUGH
  RECONFIRM_DECLINED
}

// An accepted offer tracked to closing (T304; FR-053 to FR-057). A partial unique index
// (migration) allows one active deal per package, so two concurrent accepts cannot both win.
// CHECKs: a fallen-through deal has its reason, and a pending one its reconfirmBy. Like decisions,
// deals are history: their package and offer are never deleted while they exist (RESTRICT). The reason is
// free text, so it holds ciphertext like the seller columns (XII).
model Deal {
  id                 String         @id @default(cuid())
  packageId          String
  package            ListingPackage @relation(fields: [packageId], references: [id])
  offerId            String         @unique
  offer              Offer          @relation(fields: [offerId], references: [id])
  status             DealStatus
  fellThroughReason  String?
  promotedFromBackup Boolean        @default(false)
  reconfirmBy        DateTime?
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([packageId])
}

// A setting the marketplace reads at run time instead of from code (T304; constitution IX), such
// as the net-proceeds fee assumptions. The value is checked with the key's Zod schema on read.
model ConfigEntry {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum ImportRowOutcome {
  IMPORTED
  UPDATED
  REJECTED
}

// One upload of the legacy investor file (T319, FR-061; contracts/investor-import.md). The
// IMPORT_INVESTORS job (jobId) reads the file at storageKey; the counts are set when it finishes,
// and error holds a refusal of the whole file (too large, a missing column). ignoredColumns are
// the file's columns the import does not know.
model ImportBatch {
  id             String            @id @default(cuid())
  fileName       String
  storageKey     String
  jobId          String?           @unique
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  totalRows      Int?
  imported       Int               @default(0)
  updated        Int               @default(0)
  rejected       Int               @default(0)
  ignoredColumns String[]
  error          String?
  createdBy      String
  createdAt      DateTime          @default(now())
  finishedAt     DateTime?
  rows           ImportRowResult[]
}

// What happened to one row of an import: the investor it created or updated, or why it was
// rejected. One per batch and row, so a retried job skips the rows it already did.
model ImportRowResult {
  id         String           @id @default(cuid())
  batchId    String
  batch      ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber  Int
  outcome    ImportRowOutcome
  reason     String?
  investorId String?

  @@unique([batchId, rowNumber])
}

// Who caused an audited change: a signed-in user, or the system (a job such as matching).
enum AuditActorType {
  USER
  SYSTEM
}

// Sprint 2 audits only changes that happened; REJECTED arrives with the first audited rejection.
enum AuditOutcome {
  SUCCESS
}

// The domain audit log (T282; constitution XII): one row per audit-sensitive change, written in
// the same transaction as the change, append-only (a trigger refuses UPDATE and DELETE). `action`
// and `entityType` are text checked against AUDIT_ACTIONS in code, so a new action needs no
// migration. `details` never carries PII; `correlationId` is the trace ID of the request or job.
model AuditLog {
  id            String         @id @default(cuid())
  occurredAt    DateTime       @default(now())
  actorType     AuditActorType
  actorId       String?
  action        String
  entityType    String
  entityId      String
  outcome       AuditOutcome
  correlationId String?
  details       Json           @default("{}")

  @@index([entityType, entityId, occurredAt])
}

enum IdempotencyStatus {
  IN_PROGRESS
  DONE
}

// One Idempotency-Key a user sent with a POST or PATCH (T285; constitution XX.2), stored in
// Postgres instead of Redis (plan.md Complexity Tracking). The first request claims the key
// (IN_PROGRESS); its answer is stored (DONE) and replayed for a retry with the same body. A key
// older than 24 hours is ignored and claimed again. The stored answer can hold seller details (a
// package view), so it is encrypted at rest like the seller columns (constitution XII).
model IdempotencyKey {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  method         String
  path           String
  bodyHash       String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime          @default(now())

  @@unique([userId, key])
}

enum DeliveryTarget {
  CRM
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  RETRYING
  NEEDS_ATTENTION
}

// One change an outside service must hear about (T336; constitution XVIII, contracts/events.md),
// written in the same transaction as the change, so a rolled-back change sends nothing and a saved
// one is never lost. `type` is checked against EVENT_TYPES in code; `payload` never carries seller
// details. Append-only, except that the worker's relay marks it relayed once (migration).
model OutboxEvent {
  id            String     @id @default(cuid())
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime   @default(now())
  relayedAt     DateTime?
  correlationId String?
  deliveries    Delivery[]

  @@index([aggregateType, aggregateId, occurredAt])
}

// One message to one outside target (T336): an email or text to an investor, or a listing update
// to the CRM. Its id is the Idempotency-Key the provider sees, so a retry is never applied twice.
// recipientRef is an investor ID (EMAIL, SMS) or the package ID (CRM), never contact data.
// lastError is redacted. queuedAt is null until the relay puts it on the BullMQ queue.
model Delivery {
  id            String         @id @default(cuid())
  outboxEventId String
  outboxEvent   OutboxEvent    @relation(fields: [outboxEventId], references: [id])
  target        DeliveryTarget
  recipientRef  String
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  queuedAt      DateTime?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([outboxEventId, target, recipientRef])
  @@index([status])
}
