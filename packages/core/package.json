{
  "name": "@clever/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only domain core: services, workflows, ports, and adapters (Constitution I, XXI.3; research R22).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clever/contracts": "workspace:*",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "~7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clever/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.1"
  }
}
